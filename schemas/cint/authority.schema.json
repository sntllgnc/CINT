{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cint.invalid/schema/authority-1.json",
  "title": "CINT authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "principal_id",
    "issuer_id",
    "status",
    "epoch",
    "grants",
    "policy_ids",
    "require_rollback",
    "issued_at",
    "not_before",
    "expires_at",
    "revoked_at",
    "revocation_reason",
    "digest"
  ],
  "properties": {
    "protocol": { "const": "cint/authority/1" },
    "id": { "$ref": "#/$defs/id" },
    "principal_id": { "$ref": "#/$defs/id" },
    "issuer_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["ACTIVE", "REVOKED"] },
    "epoch": { "type": "integer", "minimum": 1 },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "type", "target_digest"],
        "properties": {
          "adapter": { "$ref": "#/$defs/id" },
          "type": { "$ref": "#/$defs/id" },
          "target_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "policy_ids": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "require_rollback": { "type": "boolean" },
    "issued_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "revocation_reason": { "type": ["string", "null"] },
    "digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
